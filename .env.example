# FinSight AI - Environment Configuration Template
# Copy this file to .env and configure your keys

# Polygon.io API key for institutional market data ingestion
# Obtain a free or paid API key at https://polygon.io
POLYGON_API_KEY=your_polygon_api_key_here

# Database URL (Optional: Defaults to local SQLite if PostgreSQL is offline or omitted)
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/finsight_db
